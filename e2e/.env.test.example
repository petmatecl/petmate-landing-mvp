# e2e/.env.test.example
# Copia este archivo como e2e/.env.test y rellena los valores REALES.
# .env.test está gitignoreado — NUNCA se commitea.
#
# Todos son requeridos: si falta alguno, playwright.config.ts o auth.setup.ts
# throwean al arranque con el nombre del faltante.

# Credenciales del usuario staging (admin + proveedor).
# NUNCA usar credenciales de producción.
E2E_STAGING_EMAIL=usuario@ejemplo.cl
E2E_STAGING_PASSWORD=cambiame

# Token de bypass de Vercel Deployment Protection.
# Se obtiene en Vercel dashboard → project → Settings → Deployment Protection
# → Protection Bypass for Automation → Copy token.
PLAYWRIGHT_BYPASS=cambiame

# Cliente Supabase para setup/teardown de servicios efímeros.
# Se usa como el proveedor autenticado (JWT extraído del storageState) —
# respeta RLS, no requiere service role. Los valores son públicos (viven
# en el bundle de la app como NEXT_PUBLIC_SUPABASE_URL / ANON_KEY del
# proyecto staging), pero se leen desde acá para no acoplar los tests a
# .env de la app.
E2E_SUPABASE_URL=https://jmtadvdkicyylcwjcmcl.supabase.co
E2E_SUPABASE_ANON_KEY=cambiame

# Opcional: override de baseURL. Default es la URL del branch staging.
# La config bloquea cualquier valor que apunte a pawnecta.com o que no
# incluya "staging" en el host.
# PLAYWRIGHT_BASE_URL=https://pawnecta-landing-mvp-git-staging-petmatecls-projects.vercel.app
